{
  "model_version": "dense_ae_kaggle_v1",
  "architecture": "FlexibleDenseAutoencoder",
  "input_dim": 13,
  "bottleneck_dim": 4,
  "hidden_dim": 32,
  "feature_order": [
    "Heart_Rate",
    "SpO2",
    "Temperature",
    "Heart_Rate_Delta",
    "SpO2_Delta",
    "Temperature_Delta",
    "MA_Heart_Rate",
    "MA_SpO2",
    "MA_Temperature",
    "Var_Heart_Rate",
    "Var_SpO2",
    "Var_Temperature",
    "Rate_of_Change"
  ],
  "scaler": {
    "type": "bounded_minmax",
