    "max_bounds": [160.0, 100.0, 43.0, 40.0, 15.0, 15.0, 160.0, 100.0, 43.0, 500.0, 50.0, 70.0, 1.0]
  },
  "thresholds": {
    "warning_p95": 0.000200,
    "critical_p99": 0.001000,
    "iot_stream_warn": 0.006000,
    "iot_stream_crit": 0.010400,
    "youden_j_global": 0.000139,
    "best_f1_global": 0.000076,
    "val_normal_p95": 0.004743,
    "val_normal_p99": 0.010412
  },
  "recommended_runtime_thresholds": {
    "iot_realtime_stream": {
      "warn_threshold": 0.0060,
      "crit_threshold": 0.0104,
      "target_fpr": "<= 10%",
      "description": "Ambang batas optimal operasional stream sensor IoT dinamis (FPR actual 9.69% - 11.22%, precision > 96%)"
    },
    "clinical_screening": {
      "warn_threshold": 0.000200,
      "crit_threshold": 0.001000,
      "description": "Ambang batas Youden's J Index untuk skrining klinis sensitivitas tinggi (Recall 88.89%, F1 0.9285)"
    }
  },
  "persistence_N": 3,
  "max_gap_seconds": 5.0,
  "training_sources": [
    "engrarri21",
    "gourangomandal"
  ],
