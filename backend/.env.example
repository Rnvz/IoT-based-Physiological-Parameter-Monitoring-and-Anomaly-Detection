# MQTT Configuration
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
TOPIC_PREFIX=physiomonitor/GANTI-ID-UNIK
DEVICE_ID=esp32-01

# Decision Mode (RULE | ML)
DECISION_MODE=RULE

# Database Backend (csv | supabase)
DB_BACKEND=csv
CSV_DIR=./data
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Security & API
API_KEY=your_secret_api_key_here
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO

# Machine Learning Artifacts
MODEL_PATH=ml_pipeline/models/isolation_forest_model.joblib
SCALER_PATH=ml_pipeline/models/scaler.joblib
THRESHOLDS_PATH=ml_pipeline/models/thresholds.joblib
MODEL_VERSION=if_v1
WINDOW_SIZE=15
MAX_MESSAGE_GAP_SECONDS=5.0
PERSISTENT_ANOMALY_COUNT=3
ML_USE_DEBOUNCE=true

# Rule Engine Thresholds (Configurable)
RULE_HR_LOW_ALERT=50.0
RULE_HR_HIGH_ALERT=100.0
RULE_SPO2_ALERT=90.0
RULE_TEMP_HIGH_ALERT=38.0
RULE_TEMP_LOW_ALERT=35.0

RULE_HR_LOW_WARN=55.0
RULE_HR_HIGH_WARN=95.0
RULE_SPO2_WARN=94.0
RULE_TEMP_HIGH_WARN=37.5
RULE_TEMP_LOW_WARN=35.5

CMD_SEQ_FILE=./data/cmd_seq.json
