# ==============================================================================
# Git Ignore Configuration - IoT & ML Physiological Monitoring Research
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (Sangat Penting: Jangan commit kredensial!)
# ------------------------------------------------------------------------------
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example
secrets.h
firmware/include/secrets.h
!firmware/include/secrets.h.example
.streamlit/secrets.toml
Dashboard/

# ------------------------------------------------------------------------------
# 1.1 AI Agent Instructions & Internal Docs (Private Local Guides)
# ------------------------------------------------------------------------------
AGENTS.md
CLAUDE.md
.gemini/

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/

# Jupyter Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ------------------------------------------------------------------------------
# 3. Machine Learning Models & Datasets
# ------------------------------------------------------------------------------
# Default ignore untuk model biner besar
*.joblib
*.pkl
*.pickle
*.h5
*.hdf5
*.pt
*.pth
*.onnx

# Folder salinan lokal di root diabaikan agar tidak menduplikasi commit
/models/

# Kecualikan dan track model resmi yang aktif digunakan untuk inference
!ml_pipeline/models/
ml_pipeline/models/*
!ml_pipeline/models/.gitkeep
!ml_pipeline/models/*.joblib
!ml_pipeline/models/evaluation_report.txt
!ml_pipeline/models/evaluation_report.json
!ml_pipeline/models/physio_synthetic/
!ml_pipeline/models/physio_synthetic/**

# Datasets (CSV, Excel, Zip, Parquet)
Dataset/
/data/
*.csv
*.tsv
*.xlsx
*.parquet
*.zip
*.tar.gz
*.7z

# Kecualikan folder data di ml_pipeline jika diperlukan
!ml_pipeline/data/
ml_pipeline/data/*
!ml_pipeline/data/.gitkeep

# Evaluation results & splits
results/
splits/

# Preserve test fixtures
!tests/fixtures/
!tests/fixtures/**

# ------------------------------------------------------------------------------
# 4. Embedded / PlatformIO / Arduino Firmware
# ------------------------------------------------------------------------------
Esp/
.pio/
.pioenvs/
.piolibdeps/
.pio/build/
.pio/libdeps/
*.elf
*.bin
*.hex

# Pastikan source code Arduino .ino tetap terlacak
!*.ino
!firmware/**/*.ino

# ------------------------------------------------------------------------------
# 5. Database & Local Storage
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.csv
backend/data/*.json
!backend/data/supabase_schema.sql
!backend/data/.gitkeep

# ------------------------------------------------------------------------------
# 6. Node.js & Dashboard / Frontend
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm

# ------------------------------------------------------------------------------
# 7. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
temp/
tmp/
scratch/
*.tmp
*.pdf
*.docx

